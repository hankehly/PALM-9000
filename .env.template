PICOVOICE_ACCESS_KEY=
PORCUPINE_KEYWORD=computer
PORCUPINE_KEYWORD_PATH=
PORCUPINE_MODEL_PATH=
PVLEOPARD_MODEL_PATH=
WHISPER_MODEL=base
INPUT_DEVICE=1
SAMPLE_RATE=44100
SILENCE_TIMEOUT=1
VAD_MODE=3
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE_NAME=Enceladus
GOOGLE_CLOUD_PROJECT=

# Wake-word gating. Off by default: with it off, microphone audio streams
# to Gemini continuously while the app runs.
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL_PATH=models/wakeword/hey_livekit.onnx
WAKE_WORD_THRESHOLD=0.5
WAKE_SILENCE_TIMEOUT_SECS=10
# Samples between wake-word scoring passes (80ms at 16kHz). Larger values
# cost CPU-per-second linearly less but add up to that much wake latency.
WAKE_WORD_HOP_SAMPLES=1280
# Pause the mic while the bot speaks (no barge-in, but no echo-triggered
# self-interruption either). Set false only if echo cancellation works.
WAKE_WORD_HALF_DUPLEX=true

# Read the system instruction from this file instead of the built-in text.
# For trying personality wording without editing code or redeploying.
# Unset in normal operation; a missing or empty file is fatal.
# SYSTEM_INSTRUCTION_FILE=/tmp/prompt.txt
